{
  "annotations": {
    "list": [
      {
        "builtIn": 0,
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "enable": true,
        "expr": "increase(relay_operational_events_total[$__rate_interval]) > 0",
        "hide": false,
        "iconColor": "orange",
        "name": "Operational transitions",
        "tagKeys": "code",
        "textFormat": "{{code}}",
        "titleFormat": "Relay operational event",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "graphTooltip": 1,
  "time": { "from": "now-6h", "to": "now" },
  "timezone": "",
  "title": "Relay API Gateway",
  "uid": "relay-overview",
  "schemaVersion": 39,
  "tags": ["relay", "api-gateway"],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "label": "Data source"
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Traffic (RED)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "type": "timeseries",
      "title": "Request rate by status code",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum by (status_code) (rate(relay_requests_total[$__rate_interval]))",
          "legendFormat": "{{status_code}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "5xx error ratio",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.01 },
              { "color": "red", "value": 0.05 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "targets": [
        {
          "expr": "sum(rate(relay_requests_total{status_code=~\"5..\"}[$__rate_interval])) / clamp_min(sum(rate(relay_requests_total[$__rate_interval])), 1)",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Active requests",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "expr": "sum(relay_active_requests)", "refId": "A" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Request rate by route",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 9 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum by (route) (rate(relay_requests_total[$__rate_interval]))",
          "legendFormat": "{{route}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Request latency (p50/p95/p99)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 9 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(relay_request_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(relay_request_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(relay_request_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ]
    },
    {
      "type": "row",
      "title": "Backends & resilience",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 17 }
    },
    {
      "type": "timeseries",
      "title": "Upstream latency p95 by backend",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 18 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, backend) (rate(relay_upstream_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "{{backend}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Healthy instances by backend",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 18 },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "expr": "sum by (backend) (relay_backend_healthy)",
          "legendFormat": "{{backend}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Retries by reason",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 26 },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum by (reason) (rate(relay_retry_total[$__rate_interval]))",
          "legendFormat": "{{reason}}",
          "refId": "A"
        },
        {
          "expr": "sum(rate(relay_retry_budget_exhausted_total[$__rate_interval]))",
          "legendFormat": "budget exhausted",
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Circuit breaker state (2=open)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 26 },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0, "max": 2 }, "overrides": [] },
      "targets": [
        {
          "expr": "max by (backend) (relay_circuit_breaker_state)",
          "legendFormat": "{{backend}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Bulkhead in-flight & rejections",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 26 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum by (backend) (relay_bulkhead_in_flight)",
          "legendFormat": "in-flight {{backend}}",
          "refId": "A"
        },
        {
          "expr": "sum by (backend) (rate(relay_bulkhead_rejected_total[$__rate_interval]))",
          "legendFormat": "rejected/s {{backend}}",
          "refId": "B"
        }
      ]
    },
    {
      "type": "row",
      "title": "Operational health",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 34 }
    },
    {
      "type": "stat",
      "title": "Redis rate-limit state",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 7, "w": 6, "x": 0, "y": 35 },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 2,
          "mappings": [{ "type": "value", "options": { "0": { "text": "Healthy", "color": "green" }, "1": { "text": "Degraded", "color": "yellow" }, "2": { "text": "Unavailable", "color": "red" } } }],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 2 }] }
        },
        "overrides": []
      },
      "options": { "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "expr": "relay_rate_limit_redis_state", "refId": "A" }]
    },
    {
      "type": "timeseries",
      "title": "Redis errors and fail-open bypasses",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 7, "w": 9, "x": 6, "y": 35 },
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0 }, "overrides": [] },
      "targets": [
        { "expr": "sum(rate(relay_rate_limit_redis_checks_total{result=\"error\"}[$__rate_interval]))", "legendFormat": "Redis errors/s", "refId": "A" },
        { "expr": "sum(rate(relay_rate_limit_fail_open_bypass_total[$__rate_interval]))", "legendFormat": "bypasses/s", "refId": "B" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Reload failures and memory evictions",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 7, "w": 9, "x": 15, "y": 35 },
      "fieldConfig": { "defaults": { "unit": "ops", "min": 0 }, "overrides": [] },
      "targets": [
        { "expr": "sum(rate(relay_config_reload_total{result=\"failure\"}[$__rate_interval]))", "legendFormat": "reload failures/s", "refId": "A" },
        { "expr": "sum(rate(relay_rate_limit_memory_evictions_total[$__rate_interval]))", "legendFormat": "evictions/s", "refId": "B" }
      ]
    }
  ]
}
